package com.example.micro_smartcontract;

import java.math.BigInteger;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.stream.Collectors;

import org.web3j.abi.TypeReference;
import org.web3j.abi.datatypes.*;
import org.web3j.abi.datatypes.generated.Uint256;
import org.web3j.crypto.Credentials;
import org.web3j.protocol.Web3j;
import org.web3j.protocol.core.RemoteCall;
import org.web3j.protocol.core.methods.response.TransactionReceipt;
import org.web3j.tx.Contract;
import org.web3j.tx.gas.ContractGasProvider;
import org.web3j.tuples.generated.Tuple6;
import org.web3j.tuples.generated.Tuple5;

public class OrdonnanceContract extends Contract {

    public static final String BINARY = "";
    public static final String FUNC_CREERORDONNANCE = "creerOrdonnance";
    public static final String FUNC_VERIFIERCOMPATIBILITE = "verifierCompatibilite";
    public static final String FUNC_GETORDONNANCE = "getOrdonnance";
    public static final String FUNC_SETCOMPATIBILITE = "setCompatibilite";
    public static final String FUNC_GETALLORDONNANCES = "getAllOrdonnances";

    protected OrdonnanceContract(String contractAddress, Web3j web3j, Credentials credentials, ContractGasProvider contractGasProvider) {
        super(BINARY, contractAddress, web3j, credentials, contractGasProvider);
    }

    public static OrdonnanceContract load(String contractAddress, Web3j web3j, Credentials credentials, ContractGasProvider contractGasProvider) {
        return new OrdonnanceContract(contractAddress, web3j, credentials, contractGasProvider);
    }

    /**
     * Créer une ordonnance avec plusieurs médicaments
     */
    public RemoteCall<TransactionReceipt> creerOrdonnance(
            BigInteger patientId, String nomPatient, String maladie, List<String> medicaments
    ) {
        List<Utf8String> medicamentList = medicaments.stream().map(Utf8String::new).collect(Collectors.toList());

        final Function function = new Function(
                FUNC_CREERORDONNANCE,
                Arrays.asList(
                        new Uint256(patientId),
                        new Utf8String(nomPatient),
                        new Utf8String(maladie),
                        new DynamicArray<>(Utf8String.class, medicamentList)
                ),
                Collections.emptyList()
        );
        return executeRemoteCallTransaction(function);
    }

    /**
     * Vérifier la compatibilité
     */
    public RemoteCall<Boolean> verifierCompatibilite(String maladie, String medicament) {
        final Function function = new Function(
                FUNC_VERIFIERCOMPATIBILITE,
                Arrays.asList(new Utf8String(maladie), new Utf8String(medicament)),
                Arrays.asList(new TypeReference<Bool>() {})
        );
        return executeRemoteCallSingleValueReturn(function, Boolean.class);
    }

    /**
     * Ajouter une compatibilité
     */
    public RemoteCall<TransactionReceipt> setCompatibilite(String maladie, List<String> medicaments) {
        List<Utf8String> medList = medicaments.stream().map(Utf8String::new).collect(Collectors.toList());

        final Function function = new Function(
                FUNC_SETCOMPATIBILITE,
                Arrays.asList(new Utf8String(maladie), new DynamicArray<>(Utf8String.class, medList)),
                Collections.emptyList()
        );
        return executeRemoteCallTransaction(function);
    }

    /**
     * Lire une ordonnance avec plusieurs médicaments
     */
    public RemoteCall<Tuple5<String, String, List<String>, String, BigInteger>> getOrdonnance(BigInteger id) {
        final Function function = new Function(
                FUNC_GETORDONNANCE,
                Arrays.asList(new Uint256(id)),
                Arrays.asList(
                        new TypeReference<Utf8String>() {},           // nomPatient
                        new TypeReference<Utf8String>() {},           // maladie
                        new TypeReference<DynamicArray<Utf8String>>() {}, // medicaments
                        new TypeReference<Address>() {},              // docteur
                        new TypeReference<Uint256>() {}              // patientId
                )
        );

        return new RemoteCall<>(() -> {
            List<Type> results = executeCallMultipleValueReturn(function);
            String nomPatient = ((Utf8String) results.get(0)).getValue();
            String maladie = ((Utf8String) results.get(1)).getValue();

            @SuppressWarnings("unchecked")
            List<Utf8String> meds = (List<Utf8String>) results.get(2).getValue();
            List<String> medicaments = meds.stream().map(Utf8String::getValue).collect(Collectors.toList());

            String docteur = ((Address) results.get(3)).toString();
            BigInteger patientId = ((Uint256) results.get(4)).getValue();

            return new Tuple5<>(nomPatient, maladie, medicaments, docteur, patientId);
        });
    }

    /**
     * Retourner toutes les ordonnances (ne pas encore modifié si tu utilises string[])
     */
    public static RemoteCall<Tuple6<
            List<Uint256>, List<Uint256>, List<Utf8String>, List<Utf8String>, List<Utf8String>, List<Address>>> getAllOrdonnances(OrdonnanceContract contract) {

        final Function function = new Function(
                FUNC_GETALLORDONNANCES,
                Collections.emptyList(),
                Arrays.asList(
                        new TypeReference<DynamicArray<Uint256>>() {},
                        new TypeReference<DynamicArray<Uint256>>() {},
                        new TypeReference<DynamicArray<Utf8String>>() {},
                        new TypeReference<DynamicArray<Utf8String>>() {},
                        new TypeReference<DynamicArray<Utf8String>>() {},
                        new TypeReference<DynamicArray<Address>>() {}
                )
        );

        return new RemoteCall<>(() -> {
            List<Type> results = contract.executeCallMultipleValueReturn(function);

            return new Tuple6<>(
                    (List<Uint256>) results.get(0).getValue(),
                    (List<Uint256>) results.get(1).getValue(),
                    (List<Utf8String>) results.get(2).getValue(),
                    (List<Utf8String>) results.get(3).getValue(),
                    (List<Utf8String>) results.get(4).getValue(),
                    (List<Address>) results.get(5).getValue()
            );
        });
    }
}
